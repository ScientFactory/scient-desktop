# git autocrlf=true converts LF to CRLF on Windows, causing issues with oxfmt
* text=auto eol=lf

# Unified patch context lines intentionally contain a single leading marker.
*.patch -whitespace
# Preserve wasm2c output and vendored runtime bytes, including trailing spaces.
apps/mobile/modules/t3-highlights/Vendor/highlights/highlights.c whitespace=-blank-at-eol
apps/mobile/modules/t3-highlights/Vendor/wasm2c/wasm-rt.h whitespace=-blank-at-eol
# Batch files need CRLF for cmd.exe to parse them reliably.
*.cmd text eol=crlf
*.bat text eol=crlf
# GitHub's and Expo's GraphQL schemas and the operations graphqlgen writes from them.
packages/source-control-github/schema/** linguist-generated
apps/server/schema/** linguist-generated
**/*.graphql.ts linguist-generated
