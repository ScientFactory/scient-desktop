new file mode 100644
--- /dev/null
+++ b/dist/editor/externalHistory.js
@@ -0,0 +1,106 @@
+import { PieceTable } from "./pieceTable.js";
+
+// Scient's opt-in external-edit path. Existing programmatic edits retain their
+// upstream undo semantics. Uncertain history intersections decline atomically.
+function apply(text, edits) {
+  let result = text;
+  for (const edit of edits.toSorted((a, b) => b.start - a.start)) {
+    if (edit.start < 0 || edit.end < edit.start || edit.end > text.length) throw new Error("Invalid history range");
+    result = result.slice(0, edit.start) + edit.text + result.slice(edit.end);
+  }
+  return result;
+}
+function mapOffset(offset, edits, bias = 1) {
+  let delta = 0;
+  for (const edit of edits) {
+    if (offset < edit.start || offset === edit.start && bias < 0) break;
+    if (offset < edit.end || offset === edit.end && edit.start === edit.end) return edit.start + delta + (bias < 0 ? 0 : edit.text.length);
+    delta += edit.text.length - (edit.end - edit.start);
+  }
+  return offset + delta;
+}
+function mapEdits(edits, through, insertionBias = 1) {
+  for (const edit of edits) for (const other of through) {
+    const inside = edit.start === edit.end
+      ? edit.start > other.start && edit.start < other.end
+      : other.start === other.end
+        ? other.start > edit.start && other.start < edit.end
+        : edit.start < other.end && other.start < edit.end;
+    if (inside) return null;
+  }
+  return edits.map((edit) => ({
+    ...edit,
+    start: mapOffset(edit.start, through, edit.start === edit.end ? insertionBias : 1),
+    end: mapOffset(edit.end, through, edit.start === edit.end ? insertionBias : -1)
+  }));
+}
+function mapState(entry, side, source, updated, changes) {
+  const before = new PieceTable(source);
+  const after = new PieceTable(updated);
+  const selections = entry["selections" + side];
+  const annotations = entry["lineAnnotations" + side];
+  return {
+    ["selections" + side]: selections?.map((selection) => ({
+      ...selection,
+      start: after.positionAt(mapOffset(before.offsetAt(selection.start), changes)),
+      end: after.positionAt(mapOffset(before.offsetAt(selection.end), changes))
+    })),
+    ["lineAnnotations" + side]: annotations?.map((annotation) => annotation.lineNumber <= 0 || annotation.side === "deletions" ? annotation : ({
+      ...annotation,
+      lineNumber: after.positionAt(mapOffset(before.offsetAt({ line: annotation.lineNumber - 1, character: 0 }), changes)).line + 1
+    }))
+  };
+}
+export function prepareExternalHistory(undo, redo, source, edits) {
+  if (source.length > 256000 || undo.length + redo.length > 200) return null;
+  const started = performance.now();
+  const walk = (entries, direction) => {
+    const result = entries.slice();
+    let text = source;
+    let external = edits;
+    for (let index = entries.length - 1; index >= 0; index--) {
+      if (performance.now() - started > 40 || text.length > 256000) return null;
+      const entry = entries[index];
+      const travel = direction === "undo" ? entry.inverseEdits : entry.forwardEdits;
+      const returnEdits = direction === "undo" ? entry.forwardEdits : entry.inverseEdits;
+      const mappedTravel = mapEdits(travel, external);
+      const nextExternal = mapEdits(external, travel, -1);
+      if (!mappedTravel || !nextExternal) return null;
+      const next = apply(text, travel);
+      const merged = apply(text, external);
+      const nextMerged = apply(next, nextExternal);
+      if (apply(next, returnEdits) !== text) return null;
+      // Recover the reciprocal local edit from its actual rebased range.
+      // Mapping another insertion at a shared boundary loses its order.
+      let delta = 0;
+      const mappedReturn = mappedTravel.toSorted((a, b) => a.start - b.start || a.end - b.end).map((edit) => {
+        const start = edit.start + delta;
+        delta += edit.text.length - (edit.end - edit.start);
+        return { start, end: start + edit.text.length, text: merged.slice(edit.start, edit.end) };
+      });
+      if (apply(merged, mappedTravel) !== nextMerged || apply(nextMerged, mappedReturn) !== merged) return null;
+      const before = direction === "undo" ? next : text;
+      const after = direction === "undo" ? text : next;
+      const beforeMerged = direction === "undo" ? nextMerged : merged;
+      const afterMerged = direction === "undo" ? merged : nextMerged;
+      result[index] = {
+        ...entry,
+        forwardEdits: direction === "undo" ? mappedReturn : mappedTravel,
+        inverseEdits: direction === "undo" ? mappedTravel : mappedReturn,
+        ...mapState(entry, "Before", before, beforeMerged, direction === "undo" ? nextExternal : external),
+        ...mapState(entry, "After", after, afterMerged, direction === "undo" ? external : nextExternal),
+        undoBoundary: true
+      };
+      text = next;
+      external = nextExternal;
+    }
+    return result;
+  };
+  try {
+    const mappedUndo = walk(undo, "undo");
+    const mappedRedo = walk(redo, "redo");
+    return mappedUndo && mappedRedo ? { undo: mappedUndo, redo: mappedRedo } : null;
+  } catch {
+    return null;
+  }
+}
