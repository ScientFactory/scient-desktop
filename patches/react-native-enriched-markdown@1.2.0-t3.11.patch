+#import <XCTest/XCTest.h>
+#import <UIKit/UIPasteboard.h>
+#import "PasteboardUtils.h"
+#import "ENRMTextLinkAttributes.h"
+#import "StyleConfig.h"
+
+@interface ScientCanonicalClipboardTests : XCTestCase
+@end
+@implementation ScientCanonicalClipboardTests
+- (void)testRepeatedIdentityAndPartialSelection
+{
+  NSMutableAttributedString *text = [[NSMutableAttributedString alloc] initWithString:@"😀 details then details"];
+  [text addAttribute:NSLinkAttributeName value:@"/repo/a.ts" range:NSMakeRange(3, 7)];
+  [text addAttribute:NSLinkAttributeName value:@"/repo/a.ts" range:NSMakeRange(16, 7)];
+  [text addAttribute:ENRMCanonicalClipboardAttributeName value:@{@"index": @0, @"text": @"[**details**](</repo/a.ts>)"} range:NSMakeRange(3, 7)];
+  [text addAttribute:ENRMCanonicalClipboardAttributeName value:@{@"index": @1, @"text": @"[*details*](</repo/a.ts>)"} range:NSMakeRange(16, 7)];
+  StyleConfig *config = [StyleConfig new];
+  config.selectionClipboard = @{};
+  copyAttributedStringToPasteboard(text, nil, config);
+  XCTAssertEqualObjects(UIPasteboard.generalPasteboard.string, @"😀 [**details**](</repo/a.ts>) then [*details*](</repo/a.ts>)");
+  copyAttributedStringToPasteboard([text attributedSubstringFromRange:NSMakeRange(18, 3)], nil, config);
+  XCTAssertEqualObjects(UIPasteboard.generalPasteboard.string, @"[*details*](</repo/a.ts>)");
+}
+- (void)testContextFallbackAndOrdinaryCopy
+{
+  NSMutableAttributedString *text = [[NSMutableAttributedString alloc] initWithString:@"Screenshot"];
+  [text addAttribute:NSLinkAttributeName value:@"t3-context://v1/image/shot" range:NSMakeRange(0, text.length)];
+  StyleConfig *config = [StyleConfig new];
+  config.selectionClipboard = @{@"linkTextByUrl": @{@"t3-context://v1/image/shot": @"![Screenshot](t3-context://v1/image/shot)"}};
+  copyAttributedStringToPasteboard(text, nil, config);
+  XCTAssertEqualObjects(UIPasteboard.generalPasteboard.string, @"![Screenshot](t3-context://v1/image/shot)");
+  copyAttributedStringToPasteboard([[NSAttributedString alloc] initWithString:@"ordinary"], nil, config);
+  XCTAssertEqualObjects(UIPasteboard.generalPasteboard.string, @"ordinary");
+}
+- (void)testSelectedContextScopeAndScreenshotDependency
+{
+  NSDictionary *annotation = @{@"version": @1, @"kind": @"preview-annotation", @"contextId": @"a", @"label": @"A", @"annotationId": @"a", @"pageUrl": @"https://example.com", @"pageTitle": NSNull.null, @"comment": @"A", @"targetSummary": @"A", @"styleChanges": @[], @"screenshotContextId": @"shot"};
+  NSDictionary *image = @{@"version": @1, @"kind": @"image", @"contextId": @"shot", @"label": @"Shot", @"attachmentId": @"uploaded", @"name": @"shot.png", @"mimeType": @"image/png", @"sizeBytes": @1};
+  NSDictionary *unselected = @{@"version": @1, @"kind": @"terminal", @"contextId": @"b", @"label": @"B", @"terminalId": @"b", @"terminalLabel": @"B", @"lineStart": @0, @"lineEnd": @0, @"text": @"unselected"};
+  NSData *data = [NSJSONSerialization dataWithJSONObject:@{@"version": @1, @"source": @{@"environmentId": @"remote"}, @"records": @[annotation, image, unselected]} options:0 error:nil];
+  NSString *raw = [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding];
+  NSString *url = @"t3-context://v1/preview-annotation/a";
+  StyleConfig *config = [StyleConfig new];
+  config.selectionClipboard = @{@"contextFragment": raw, @"linkTextByUrl": @{url: @"[A](t3-context://v1/preview-annotation/a)"}};
+  NSMutableAttributedString *text = [[NSMutableAttributedString alloc] initWithString:@"A"];
+  [text addAttribute:NSLinkAttributeName value:url range:NSMakeRange(0, 1)];
+  copyAttributedStringToPasteboard(text, nil, config);
+  NSDictionary *payload = [NSJSONSerialization JSONObjectWithData:UIPasteboard.generalPasteboard.items[0][@"app.t3.context-fragment"] options:0 error:nil];
+  XCTAssertEqualObjects([payload[@"records"] valueForKey:@"contextId"], (@[@"a", @"shot"]));
+  XCTAssertEqualObjects(payload[@"source"][@"environmentId"], @"remote");
+  for (NSString *value in @[@"file", @"$ui", @"ordinary"]) {
+    NSMutableAttributedString *other = [[NSMutableAttributedString alloc] initWithString:value];
+    [other addAttribute:ENRMCanonicalClipboardAttributeName value:@{@"text": value, @"index": @0} range:NSMakeRange(0, value.length)];
+    copyAttributedStringToPasteboard(other, nil, config);
+    XCTAssertNil(UIPasteboard.generalPasteboard.items[0][@"app.t3.context-fragment"]);
+    NSData *html = UIPasteboard.generalPasteboard.items[0][kUTIHTML];
+    XCTAssertFalse([[[NSString alloc] initWithData:html encoding:NSUTF8StringEncoding] containsString:@"data-t3-context-fragment"]);
+  }
+}
+- (void)testRecognizedFilePartialCopyAndUnknownVersionRefusal
+{
+  NSMutableAttributedString *file = [[NSMutableAttributedString alloc] initWithString:@"/tmp/frame.png"];
+  [file addAttribute:ENRMCanonicalClipboardAttributeName value:@{@"text": @"[frame.png](</tmp/frame.png>)", @"recognizedStart": @0} range:NSMakeRange(0, file.length)];
+  StyleConfig *config = [StyleConfig new];
+  config.selectionClipboard = @{};
+  copyAttributedStringToPasteboard([file attributedSubstringFromRange:NSMakeRange(3, 5)], nil, config);
+  XCTAssertEqualObjects(UIPasteboard.generalPasteboard.string, @"[frame.png](</tmp/frame.png>)");
+  for (NSString *raw in @[@"invalid", @"{\"version\":2}", @"{\"version\":true}", @"{\"version\":1.5}"]) {
+    config.selectionClipboard = @{@"contextFragment": raw};
+    copyAttributedStringToPasteboard(file, nil, config);
+    XCTAssertNil(UIPasteboard.generalPasteboard.items[0][@"app.t3.context-fragment"]);
+  }
+}
