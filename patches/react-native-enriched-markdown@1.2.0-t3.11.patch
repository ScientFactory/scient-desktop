diff --git a/repair/package/tests/cpp/CanonicalLinkIndexTest.cpp b/tests/cpp/CanonicalLinkIndexTest.cpp
new file mode 100644
index 0000000..f27f039
--- /dev/null
+++ b/tests/cpp/CanonicalLinkIndexTest.cpp
@@ -0,0 +1,52 @@
+#include "../../cpp/parser/MD4CParser.hpp"
+#include <cassert>
+#include <vector>
+using namespace Markdown;
+static void links(const std::shared_ptr<MarkdownASTNode> &node, std::vector<std::shared_ptr<MarkdownASTNode>> &out) {
+  if (node->type == NodeType::Link) out.push_back(node);
+  for (const auto &child : node->children) links(child, out);
+}
+static std::string textContent(const std::shared_ptr<MarkdownASTNode> &node) {
+  std::string text = node->content;
+  for (const auto &child : node->children) text += textContent(child);
+  return text;
+}
+int main() {
+  MD4CParser parser;
+  Md4cFlags flags;
+  flags.latexMath = false;
+  std::vector<std::shared_ptr<MarkdownASTNode>> found;
+  links(parser.parse("[**details**](</repo/a.ts>) [*details*](/repo/a.ts)\n\n> [third](/repo/a.ts)", flags), found);
+  assert(found.size() == 3);
+  for (size_t index = 0; index < found.size(); ++index) {
+    assert(found[index]->attributes.at("clipboardLinkIndex") == std::to_string(index));
+    assert(found[index]->attributes.at("url") == "/repo/a.ts");
+  }
+  found.clear();
+  links(parser.parse("`[example](/repo/a.ts)` [next](/repo/a.ts)", flags), found);
+  assert(found.size() == 1 && found[0]->attributes.at("clipboardLinkIndex") == "0");
+  found.clear();
+  links(parser.parse("<https://example.com> [ref][file]\n\n[file]: /repo/a.ts", flags), found);
+  assert(found.size() == 2 && found[1]->attributes.at("clipboardLinkIndex") == "1");
+  found.clear();
+  links(parser.parse(R"([settings](C:\\Users\\me\\.t3\\settings.json))", flags), found);
+  assert(found.size() == 1 && found[0]->attributes.at("url") == R"(C:\Users\me\.t3\settings.json)");
+  found.clear();
+  links(parser.parse(R"([file](<C:\\_dir\\file](part).txt>))", flags), found);
+  assert(found.size() == 1 && found[0]->attributes.at("url") == R"(C:\_dir\file](part).txt)");
+  found.clear();
+  links(parser.parse("[line&#10;&#10;two&#9;three&#13;four](/repo/a.ts) [next](/repo/b.ts)", flags), found);
+  assert(found.size() == 2);
+  assert(textContent(found[0]) == "line\n\ntwo\tthree\rfour");
+  assert(found[0]->attributes.at("clipboardLinkIndex") == "0");
+  assert(found[1]->attributes.at("clipboardLinkIndex") == "1");
+  found.clear();
+  auto controls = parser.parse("&#9;# heading&#10;&#10;- item", flags);
+  assert(textContent(controls) == "\t# heading\n\n- item");
+  assert(controls->children.size() == 1 && controls->children[0]->type == NodeType::Paragraph);
+  assert(textContent(parser.parse(R"(before \&\#0\; after)", flags)) == "before &#0; after");
+  found.clear();
+  links(parser.parse(R"([details](</repo/a\&b.ts>) [literal](</repo/a\&amp;b.ts>))", flags), found);
+  assert(found.size() == 2 && found[0]->attributes.at("url") == "/repo/a&b.ts");
+  assert(found[1]->attributes.at("url") == "/repo/a&amp;b.ts");
+}
