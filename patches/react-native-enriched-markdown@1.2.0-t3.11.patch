+    if (source.opt("environmentId") !is String || source.optString("environmentId").isBlank()) return null
+    val records = payload.optJSONArray("records") ?: return null
+    if (records.length() > 200) return null
+    val ids = mutableSetOf<String>()
+    for (index in 0 until records.length()) {
+      val record = records.optJSONObject(index) ?: return null
+      val id = record.opt("contextId") as? String ?: return null
+      val kind = record.opt("kind") as? String ?: return null
