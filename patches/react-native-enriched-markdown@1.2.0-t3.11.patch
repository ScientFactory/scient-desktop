diff --git a/repair/package/android/src/test/java/com/swmansion/enriched/markdown/utils/text/view/CanonicalClipboardTest.kt b/android/src/test/java/com/swmansion/enriched/markdown/utils/text/view/CanonicalClipboardTest.kt
