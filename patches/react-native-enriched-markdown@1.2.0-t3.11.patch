+++ b/android/src/test/java/com/swmansion/enriched/markdown/utils/text/view/CanonicalClipboardTest.kt
@@ -0,0 +1,57 @@
+package com.swmansion.enriched.markdown.utils.text.view
+
+import android.text.SpannableString
+import android.text.Spanned
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [36], manifest = Config.NONE)
+class CanonicalClipboardTest {
+  @Test fun repeatedUrlAndLabelKeepTheirOwnFormatting() {
+    val text = SpannableString("😀 details then details")
+    text.setSpan(CanonicalClipboardSpan("[**details**](</repo/a.ts>)", 0), 3, 10, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+    text.setSpan(CanonicalClipboardSpan("[*details*](</repo/a.ts>)", 1), 16, 23, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+    assertEquals("😀 [**details**](</repo/a.ts>) then [*details*](</repo/a.ts>)", canonicalClipboardText(text, SelectionClipboardConfig()))
+    assertEquals("[*details*](</repo/a.ts>)", canonicalClipboardText(text.subSequence(18, 21) as Spanned, SelectionClipboardConfig()))
+  }
+  @Test fun parserIndexAndUrlMustBothMatch() {
+    val config = SelectionClipboardConfig.parse("""{"linkSources":[{"url":"/repo/a.ts","source":"first"},{"url":"/repo/a.ts","source":"second"}]}""")
+    assertEquals("first", config.sourceForLink(0, "/repo/a.ts"))
+    assertEquals("second", config.sourceForLink(1, "/repo/a.ts"))
+    assertNull(config.sourceForLink(1, "/repo/b.ts"))
+    assertNull(config.sourceForLink(-1, "/repo/a.ts"))
+    assertNull(config.sourceForLink(null, "/repo/a.ts"))
+  }
+  @Test fun absentMetadataKeepsOrdinaryCopy() {
+    assertNull(canonicalClipboardText(SpannableString("ordinary text"), SelectionClipboardConfig.parse("invalid")))
+  }
+  @Test fun recognizedFileSourceKeepsFullCanonicalCopyForAPartialSelection() {
+    val text = SpannableString("/tmp/frame.png")
+    text.setSpan(CanonicalClipboardSpan("[frame.png](</tmp/frame.png>)", 0), 0, text.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+    assertEquals("[frame.png](</tmp/frame.png>)", canonicalClipboardText(text.subSequence(3, 8) as Spanned, SelectionClipboardConfig()))
+  }
+  @Test fun selectedContextOnlyKeepsAnnotationScreenshotDependency() {
+    val raw = """{"version":1,"source":{"environmentId":"remote"},"records":[{"version":1,"kind":"preview-annotation","contextId":"a","label":"A","annotationId":"a","pageUrl":"https://example.com","pageTitle":null,"comment":"A","targetSummary":"A","styleChanges":[],"screenshotContextId":"shot"},{"version":1,"kind":"image","contextId":"shot","label":"Shot","attachmentId":"uploaded","name":"shot.png","mimeType":"image/png","sizeBytes":1},{"version":1,"kind":"terminal","contextId":"b","label":"B","terminalId":"b","terminalLabel":"B","lineStart":0,"lineEnd":0,"text":"unselected"}]}"""
+    val config = SelectionClipboardConfig(contextFragment = raw)
+    val url = "t3-context://v1/preview-annotation/a"
+    val selected = selectedContextFragment(setOf(url), "[A]($url)", config)!!
+    val copied = org.json.JSONObject(selected).getJSONArray("records")
+    assertEquals(2, copied.length())
+    assertEquals("a", copied.getJSONObject(0).getString("contextId"))
+    assertEquals("shot", copied.getJSONObject(1).getString("contextId"))
+    assertEquals("remote", org.json.JSONObject(selected).getJSONObject("source").getString("environmentId"))
+    assertNull(selectedContextFragment(setOf("/repo/a.ts"), "[A]($url)", config))
+    assertNull(selectedContextFragment(setOf("$" + "ui"), "$" + "ui", config))
+    assertNull(selectedContextFragment(emptySet(), "ordinary", config))
+  }
+  @Test fun malformedAndUnknownVersionFragmentsDoNotGrantClipboardMetadata() {
+    val url = "t3-context://v1/terminal/a"
+    for (raw in listOf("invalid", "{\"version\":2}", "{\"version\":true}", "{\"version\":1.5}", "{\"version\":1,\"source\":{},\"records\":[]}")) {
+      assertNull(selectedContextFragment(setOf(url), "[A]($url)", SelectionClipboardConfig(contextFragment = raw)))
+    }
+  }
+}
